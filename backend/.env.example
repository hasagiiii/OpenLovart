# OpenLovart backend configuration.
# Copy to `.env` and adjust as needed. Values set in the real shell environment
# always override values in this file.

# =============================================================================
# Core runtime
# =============================================================================

# Environment selector. Use "dev" for local development; any other value
# (typically "prod") switches to JSON logging and Gin release mode and tightens
# validation (forces AUTH_COOKIE_SECURE=true, requires JWT key paths, etc.).
ENV=dev

# Address the HTTP server binds to. Format follows net.Listen ("[host]:port").
HTTP_ADDR=:8080

# Minimum log level. One of: debug, info, warn, error.
LOG_LEVEL=info

# PostgreSQL DSN consumed by GORM. The default points at the local
# docker-compose Postgres provided by `docker-compose.dev.yml`.
DATABASE_URL=postgres://openlovart:openlovart@localhost:5434/openlovart?sslmode=disable

# Origin of the frontend (e.g. https://app.example.com). When non-empty the
# server emits CORS headers allowing this origin with credentials. Leave blank
# in dev when the Next.js rewrite proxy makes the browser see same-origin.
FRONTEND_ORIGIN=

# =============================================================================
# Auth — JWT signing (RS256) and JWKS distribution
# =============================================================================
# Access tokens are signed with RS256. Public keys are published at
#   GET /api/auth/.well-known/jwks.json
# The frontend (and any other relying party) verifies tokens using that JWKS
# endpoint. There is NO shared symmetric secret anywhere.
#
# Dev: leave both _PATH variables blank. On first run the backend writes a
# fresh 2048-bit RSA keypair to backend/.dev-keys/jwt.{key,pub} (mode 0600/0644)
# and reuses it on subsequent runs. .dev-keys/ is gitignored.
#
# Prod: BOTH paths are REQUIRED and validated to exist + be readable on boot.
# Generate a keypair like:
#   openssl genrsa -out /etc/openlovart/jwt.key 2048
#   openssl rsa -in /etc/openlovart/jwt.key -pubout -out /etc/openlovart/jwt.pub
AUTH_JWT_PRIVATE_KEY_PATH=
AUTH_JWT_PUBLIC_KEY_PATH=

# HMAC secret used to sign the short-lived OIDC `state` cookie. This is
# INDEPENDENT of the JWT signing keys (rotating one must not require rotating
# the other). Must be ≥32 random bytes; required in prod, optional in dev.
# Generate one with: `openssl rand -base64 48`.
AUTH_OIDC_STATE_SECRET=

# Access cookie / refresh cookie lifetimes. Use Go duration syntax.
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h

# Cookie domain. Leave blank to scope cookies to the request host (recommended
# in dev so the __Host- prefix works without TLS).
AUTH_COOKIE_DOMAIN=

# Whether auth cookies carry the Secure attribute (and the __Host- prefix).
# MUST be true in prod (validated). MUST be false in dev over plain http.
AUTH_COOKIE_SECURE=false

# =============================================================================
# Auth — Google OIDC
# =============================================================================
# Obtain credentials in Google Cloud Console:
#   APIs & Services → Credentials → OAuth client ID → Web application
# Add the redirect URL below to "Authorized redirect URIs".
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/oidc/google/callback

# =============================================================================
# Email transport (SMTP)
# =============================================================================
# Defaults target the bundled Mailpit container (docker-compose.dev.yml).
# Mailpit web UI: http://localhost:8025 (no auth, dev only).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=OpenLovart <no-reply@openlovart.local>

# Public-facing URLs embedded in transactional emails.
EMAIL_VERIFY_BASE_URL=http://localhost:3000/sign-in/verify-email
PASSWORD_RESET_BASE_URL=http://localhost:3000/sign-in/reset-password

# =============================================================================
# Rate limits
# =============================================================================
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=20

# =============================================================================
# AI generation — chat (trpc-agent-go), image provider, and web search
# =============================================================================
# All values below are optional. When a credential is absent the relevant
# feature degrades gracefully: chat without OPENAI_API_KEY errors only when
# called; web search without AI_SEARCH_API_KEY simply disables the tool. No AI
# provider credential is ever exposed to the frontend.

# Chat model driving the agent. Authenticated via OPENAI_API_KEY against an
# OpenAI-compatible endpoint (OPENAI_BASE_URL).
AI_CHAT_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opentk.ai/v1

# Image generation provider. The first supported provider is "fal". The
# credential may be supplied as AI_IMAGE_API_KEY or, as a fallback, FAL_KEY.
AI_IMAGE_PROVIDER=fal
AI_IMAGE_MODEL=
AI_IMAGE_API_KEY=
# FAL_KEY=

# Web search provider for the chat agent's `web_search` tool. Defaults to
# "brave"; leave AI_SEARCH_API_KEY blank to disable the tool entirely.
AI_SEARCH_PROVIDER=brave
AI_SEARCH_API_KEY=
