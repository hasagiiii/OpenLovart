# Next.js (frontend) configuration.
#
# Copy to `.env.local` (gitignored) and adjust as needed. Server-side
# variables here are read only by the Next.js server (API routes,
# server components, middleware). Variables prefixed with NEXT_PUBLIC_*
# are bundled into the client — never put secrets there.
#
# IMPORTANT: this file MUST NOT contain any signing secret. All JWT
# signing happens in the Go backend; the frontend only verifies access
# tokens via the public JWKS endpoint.

# =============================================================================
# Backend integration
# =============================================================================

# URL the Next.js *server* uses to reach the Go backend. Used by:
#   - getServerSession() in src/lib/auth/server.ts to fetch the JWKS
#   - the dev rewrite proxy in next.config.ts to forward /api/auth/*,
#     /api/projects/*, /api/credits to the backend
#
# In dev this is the local backend port. In production, set this to
# the internal/private URL of the backend (e.g. via service discovery).
BACKEND_INTERNAL_URL=http://localhost:8080

# JWKS in-memory cache TTL (seconds) for getServerSession() and the
# Edge middleware. Matches the backend's Cache-Control: public, max-age=300.
AUTH_JWKS_CACHE_TTL=300

# =============================================================================
# AI service keys (used by the BFF routes under src/app/api/)
# =============================================================================

# Google Gemini — image generation. https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# X.AI Grok — design suggestions. https://console.x.ai/
XAI_API_KEY=

# Video generation (ClockAPI). https://www.clockapi.fun/
VIDEO_API_BASE_URL=https://www.clockapi.fun/v1
VIDEO_API_KEY=
